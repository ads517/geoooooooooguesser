rules_version = '2';

// Paste this into Firebase: Firestore Database -> Rules -> Publish.
// It keeps one counter per month and only lets it go up by one at a time,
// never past 4,500. If you change the limit in config.js, change 4500 here too.
service cloud.firestore {
  match /databases/{database}/documents {
    match /streetViewUsage/{month} {
      allow read: if true;
      allow create: if month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 4500;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
